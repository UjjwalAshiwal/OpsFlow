// Provisional baseline schema. Every model here is required by the challenge
// phases; see ENGINEERING_DECISIONS.md for what was deliberately omitted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// Team-level roles. LEAD manages the roster and may mutate any item in the
// team; MEMBER reads team items and mutates only items they created or own.
// Global ADMIN bypasses all team checks. See ENGINEERING_DECISIONS.md §15.
enum TeamRole {
  MEMBER
  LEAD
}

// Small explicit priority set. No due dates / overdue semantics (not required).
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkItemStatus {
  OPEN
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum ActivityType {
  CREATED
  FIELD_UPDATED
  STATE_CHANGED
}

enum IdempotencyStatus {
  PENDING
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())

  sessions        Session[]
  createdItems    WorkItem[]      @relation("CreatedItems")
  assignedItems   WorkItem[]      @relation("AssignedItems")
  activityEvents  ActivityEvent[]
  memberships     TeamMembership[]

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model WorkItem {
  id          String         @id @default(cuid())
  title       String
  description String         @default("")
  status      WorkItemStatus @default(OPEN)
  priority    Priority       @default(MEDIUM)
  creatorId   String
  creator     User           @relation("CreatedItems", fields: [creatorId], references: [id], onDelete: Restrict)
  assigneeId  String?
  assignee    User?          @relation("AssignedItems", fields: [assigneeId], references: [id], onDelete: SetNull)
  teamId      String?
  team        Team?          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  activityEvents ActivityEvent[]
  idempotencyKey String? // idempotency key that created this item (audit aid)

  // Deterministic cursor ordering (createdAt DESC, id DESC) + common filters.
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([teamId])
  @@index([priority])
}

model Team {
  id          String           @id @default(cuid())
  name        String
  createdAt   DateTime         @default(now())
  memberships TeamMembership[]
  workItems   WorkItem[]
}

model TeamMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model ActivityEvent {
  id         String         @id @default(cuid())
  workItemId String
  workItem   WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type       ActivityType
  fromStatus WorkItemStatus?
  toStatus   WorkItemStatus?
  // Structured domain changes, e.g. { "title": { "from": "a", "to": "b" } }.
  changes    Json?
  createdAt  DateTime       @default(now())

  // History is read newest-first per item.
  @@index([workItemId, createdAt(sort: Desc), id(sort: Desc)])
}

// Idempotency for POST /api/work-items. Scope isolates keys per user+route so
// unrelated operations can never collide; DB uniqueness wins concurrent races.
model IdempotencyRecord {
  id          String            @id @default(cuid())
  scope       String // e.g. "POST:/api/work-items:{userId}"
  key         String
  fingerprint String // sha256 of canonical request body
  status      IdempotencyStatus @default(PENDING)
  statusCode  Int?
  body        Json?
  workItemId  String?
  expiresAt   DateTime
  createdAt   DateTime          @default(now())

  @@unique([scope, key])
  @@index([expiresAt])
}
